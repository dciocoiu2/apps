  <!-- Connections -->
  <connections>
    <!-- Chirp source -> TX sink -->
    <connect>
      <src>chirp_source</src>
      <src_port>0</src_port>
      <dst>osmocom_sink_tx</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- Chirp source -> conjugate_ref -->
    <connect>
      <src>chirp_source</src>
      <src_port>0</src_port>
      <dst>conjugate_ref</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- conjugate_ref -> multiply (port 1) -->
    <connect>
      <src>conjugate_ref</src>
      <src_port>0</src_port>
      <dst>multiply_dechirp</dst>
      <dst_port>1</dst_port>
    </connect>

    <!-- RX source -> multiply (port 0) -->
    <connect>
      <src>osmocom_src_rx</src>
      <src_port>0</src_port>
      <dst>multiply_dechirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- multiply -> lowpass -->
    <connect>
      <src>multiply_dechirp</src>
      <src_port>0</src_port>
      <dst>lowpass_after_dechirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- lowpass -> waterfall -->
