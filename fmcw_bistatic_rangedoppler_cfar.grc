  <!-- Range-Doppler Python block: buffers n_chirps of vec_len floats, computes Doppler FFT, outputs flattened image (float vector of size vec_len*n_chirps) -->
  <python_block>
    <id>range_doppler_block</id>
    <name>range_doppler_block</name>
    <category>Custom</category>
    <import>import numpy as np
from gnuradio import gr</import>
    <make>def __init__(self, vec_len, n_chirps):
    gr.sync_block.__init__(self,
        name='range_doppler_block',
        in_sig=[(np.float32, int(vec_len))],
        out_sig=[(np.float32, int(vec_len*int(n_chirps)))])
    self.vec_len = int(vec_len)
    self.n_chirps = int(n_chirps)
    self.buffer = np.zeros((self.n_chirps, self.vec_len), dtype=np.float32)
    self.ptr = 0
</make>
    <work>def work(self, input_items, output_items):
    in0 = input_items[0]
    n_items = in0.shape[0]
    out = output_items[0]
    out_count = 0
    for i in range(n_items):
        self.buffer[self.ptr, :] = in0[i].astype(np.float32)
        self.ptr += 1
        if self.ptr >= self.n_chirps:
            # Doppler FFT across chirps (axis 0)
            doppler = np.fft.fftshift(np.fft.fft(self.buffer, axis=0, n=self.n_chirps), axes=0)
            mag = np.abs(doppler)
            mag_db = 20.0 * np.log10(mag + 1e-12)
            # normalize to 0..1
            mag_db -= mag_db.max()
            mag_norm = (mag_db - mag_db.min()) / (mag_db.max() - mag_db.min() + 1e-12)
            frame = mag_norm.astype(np.float32).ravel()
            out[out_count, :len(frame)] = frame
            out_count += 1
            self.ptr = 0
    return out_count
</work>
    <params>
      <param>
        <name>vec_len</name>
        <type>int</type>
        <value>%(vec_len)s</value>
      </param>
      <param>
        <name>n_chirps</name>
        <type>int</type>
        <value>%(n_chirps)s</value>
      </param>
    </params>
  </python_block>

  <!-- CFAR Python block: 2D CA-CFAR on flattened frame -->
  <python_block>
    <id>cfar_block</id>
    <name>cfar_block</name>
    <category>Custom</category>
    <import>import numpy as np
from gnuradio import gr</import>
    <make>def __init__(self, vec_len, n_chirps, guard_range, train_range, guard_doppler, train_doppler, threshold_db):
    gr.sync_block.__init__(self,
        name='cfar_block',
        in_sig=[(np.float32, int(vec_len*int(n_chirps)))],
        out_sig=[(np.float32, int(vec_len*int(n_chirps)))])
    self.vec_len = int(vec_len)
    self.n_chirps = int(n_chirps)
    self.rows = int(n_chirps)   # Doppler axis
    self.cols = int(vec_len)    # Range axis
    self.guard_range = int(guard_range)
    self.train_range = int(train_range)
    self.guard_doppler = int(guard_doppler)
    self.train_doppler = int(train_doppler)
    self.threshold_db = float(threshold_db)
</make>
    <work>def work(self, input_items, output_items):
    in0 = input_items[0]
    out = output_items[0]
    n_items = in0.shape[0]
    out_count = 0
    # Precompute window sizes
    tr = self.train_range
    tg = self.guard_range
    td = self.train_doppler
    tg_d = self.guard_doppler
    win_r = tr*2 + tg*2 + 1
    win_d = td*2 + tg_d*2 + 1
    for i in range(n_items):
        frame = in0[i].astype(np.float32).reshape((self.rows, self.cols))
        # convert back from normalized 0..1 to linear scale for CFAR averaging
        # treat input as linear magnitude (already normalized); use linear averaging
        mag = np.power(10.0, (frame * 60.0 - 60.0)/20.0)  # heuristic mapping back to linear
        mask = np.zeros_like(frame, dtype=np.float32)
        # iterate over valid CUT positions avoiding edges
        for r in range(self.rows):
            r_start = r - (td + tg_d + td)
            r_end = r + (td + tg_d + td)
            for c in range(self.cols):
                c_start = c - (tr + tg + tr)
                c_end = c + (tr + tg + tr)
                # check window bounds
                if r_start < 0 or c_start < 0 or r_end >= self.rows or c_end >= self.cols:
                    continue
                # extract window
                window = mag[r_start:r_end+1, c_start:c_end+1]
                # zero out guard cells and CUT
                gr0 = td
                gc0 = tr
                # compute indices of guard region relative to window
                rr0 = (r - r_start)
                cc0 = (c - c_start)
                # mask guard+cut
                window_copy = window.copy()
                window_copy[rr0 - tg_d: rr0 + tg_d + 1, cc0 - tg: cc0 + tg + 1] = 0.0
                # sum training cells
                training_sum = window_copy.sum()
                n_training = window_copy.size - ( (2*tg_d+1)*(2*tg+1) )
                if n_training <= 0:
                    continue
                noise_level = training_sum / float(n_training)
                # threshold linear
                threshold_linear = noise_level * (10.0**(self.threshold_db/20.0))
                if mag[r, c] > threshold_linear:
                    mask[r, c] = 1.0
        out_frame = mask.ravel().astype(np.float32)
        out[out_count, :len(out_frame)] = out_frame
        out_count += 1
    return out_count
</work>
    <params>
      <param>
        <name>vec_len</name>
        <type>int</type>
        <value>%(vec_len)s</value>
      </param>
      <param>
        <name>n_chirps</name>
        <type>int</type>
        <value>%(n_chirps)s</value>
