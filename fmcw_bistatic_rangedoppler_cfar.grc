<flow_graph>
  <title>FMCW_Bistatic_RangeDoppler_CFAR_Realtime</title>
  <author>Generated</author>
  <description>Realtime FMCW bistatic range-Doppler with 2D CA-CFAR detector. HackRF A TX, HackRF B RX. Ensure HackRF A 10MHz OUT -> HackRF B 10MHz IN. Use attenuators and filters for bench tests.</description>
  <id>fmcw_bistatic_rangedoppler_cfar_realtime</id>

  <!-- Variables -->
  <variable>
    <name>center_freq</name>
    <value>2440000000</value>
    <type>float</type>
    <desc>Center frequency (Hz)</desc>
  </variable>

