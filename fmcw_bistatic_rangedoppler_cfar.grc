      <src_port>0</src_port>
      <dst>qtgui_waterfall</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- lowpass -> stream_to_vector_chirp -->
    <connect>
      <src>lowpass_after_dechirp</src>
      <src_port>0</src_port>
      <dst>stream_to_vector_chirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- stream_to_vector_chirp -> fft_per_chirp -->
    <connect>
      <src>stream_to_vector_chirp</src>
      <src_port>0</src_port>
      <dst>fft_per_chirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- fft_per_chirp -> c2m2 -->
    <connect>
      <src>fft_per_chirp</src>
      <src_port>0</src_port>
      <dst>c2m2</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- c2m2 (vector) -> vector_to_stream -->
    <connect>
      <src>c2m2</src>
      <src_port>0</src_port>
      <dst>vector_to_stream</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- vector_to_stream -> range_doppler_block (input is vec_len floats per chirp) -->
    <connect>
      <src>vector_to_stream</src>
      <src_port>0</src_port>
      <dst>range_doppler_block</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- range_doppler_block -> qtgui_rangedoppler_image -->
    <connect>
      <src>range_doppler_block</src>
      <src_port>0</src_port>
      <dst>qtgui_rangedoppler_image</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- range_doppler_block -> cfar_block -->
    <connect>
      <src>range_doppler_block</src>
      <src_port>0</src_port>
      <dst>cfar_block</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- cfar_block -> qtgui_cfar_image -->
    <connect>
      <src>cfar_block</src>
      <src_port>0</src_port>
      <dst>qtgui_cfar_image</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- cfar_block -> file_sink_detections -->
    <connect>
      <src>cfar_block</src>
      <src_port>0</src_port>
      <dst>file_sink_detections</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- Also feed per-chirp range plot: vector_to_stream -> qtgui_range_plot -->
    <connect>
      <src>vector_to_stream</src>
      <src_port>0</src_port>
      <dst>qtgui_range_plot</dst>
      <dst_port>0</dst_port>
    </connect>
  </connections>

