    <value>hackrf=1</value>
    <type>string</type>
    <desc>RX HackRF device args</desc>
  </variable>

  <!-- CFAR parameters -->
  <variable>
    <name>guard_range</name>
    <value>2</value>
    <type>int</type>
    <desc>Guard cells in range dimension</desc>
  </variable>

  <variable>
    <name>train_range</name>
    <value>8</value>
    <type>int</type>
    <desc>Training cells in range dimension (each side)</desc>
  </variable>

  <variable>
    <name>guard_doppler</name>
    <value>1</value>
    <type>int</type>
    <desc>Guard cells in Doppler dimension</desc>
  </variable>

  <variable>
    <name>train_doppler</name>
    <value>4</value>
    <type>int</type>
    <desc>Training cells in Doppler dimension (each side)</desc>
  </variable>

  <variable>
    <name>cfar_threshold_db</name>
    <value>6.0</value>
    <type>float</type>
    <desc>CFAR threshold in dB above noise estimate</desc>
  </variable>

  <!-- Computed parameters -->
  <param_compute>
    <param>
      <name>vec_len</name>
      <expr>int(round(chirp_time * samp_rate))</expr>
    </param>
    <param>
      <name>k_slope</name>
      <expr>chirp_bw / chirp_time</expr>
    </param>
  </param_compute>

  <!-- Blocks -->

  <!-- Python chirp generator block -->
  <python_block>
    <id>chirp_source</id>
    <name>chirp_source</name>
    <category>Custom</category>
    <import>import numpy as np
from gnuradio import gr</import>
    <make>def __init__(self, samp_rate, chirp_bw, chirp_time, prf):
    gr.sync_block.__init__(self,
        name='chirp_source',
        in_sig=None,
        out_sig=[np.complex64])
    self.samp_rate = float(samp_rate)
    self.chirp_bw = float(chirp_bw)
    self.chirp_time = float(chirp_time)
    self.prf = float(prf)
    self.chirp_len = int(round(self.chirp_time * self.samp_rate))
    if self.chirp_len < 16:
        self.chirp_len = 16
    t = np.arange(self.chirp_len) / self.samp_rate
    k = self.chirp_bw / self.chirp_time
    phase = 2.0 * np.pi * (0.5 * k * t**2)
    self.chirp = (np.exp(1j * phase)).astype(np.complex64)
    idle_len = int(round((1.0/self.prf - self.chirp_time) * self.samp_rate)) if self.prf>0 else 0
    if idle_len < 0:
        idle_len = 0
    self.packet = np.concatenate((self.chirp, np.zeros(idle_len, dtype=np.complex64)))
    self.ptr = 0
</make>
    <work>def work(self, input_items, output_items):
    out = output_items[0]
    n = len(out)
    for i in range(n):
        out[i] = self.packet[self.ptr]
        self.ptr += 1
        if self.ptr >= len(self.packet):
            self.ptr = 0
    return n
</work>
    <params>
      <param>
        <name>samp_rate</name>
        <type>float</type>
        <value>%(samp_rate)s</value>
      </param>
      <param>
        <name>chirp_bw</name>
        <type>float</type>
        <value>%(chirp_bw)s</value>
      </param>
      <param>
        <name>chirp_time</name>
        <type>float</type>
        <value>%(chirp_time)s</value>
      </param>
      <param>
        <name>prf</name>
        <type>float</type>
        <value>%(prf)s</value>
      </param>
    </params>
  </python_block>

