      <value>0</value>
    </param>
    <param>
      <name>name</name>
      <value>Beat Waterfall</value>
    </param>
  </block>

  <!-- Stream to vector to get per-chirp vectors -->
  <block>
    <key>blocks.stream_to_vector</key>
    <id>stream_to_vector</id>
    <param>
      <name>vlen</name>
      <value>%(vec_len)s</value>
    </param>
  </block>

  <!-- FFT per vector (range FFT) -->
  <block>
    <key>fft.fft_vcc</key>
    <id>fft_block</id>
    <param>
      <name>vlen</name>
      <value>%(vec_len)s</value>
    </param>
    <param>
      <name>forward</name>
      <value>True</value>
    </param>
  </block>

  <!-- Complex to Mag^2 -->
  <block>
    <key>blocks.complex_to_mag_squared</key>
    <id>c2m2</id>
  </block>

  <!-- Vector to Stream (float) for feeding image sink -->
  <block>
    <key>blocks.vector_to_stream</key>
    <id>vector_to_stream</id>
    <param>
      <name>vlen</name>
      <value>%(vec_len)s</value>
    </param>
  </block>

  <!-- QT GUI Sink (FFT magnitude per chirp) -->
  <block>
    <key>qtgui.time_sink_f</key>
    <id>qtgui_range_plot</id>
    <param>
      <name>size</name>
      <value>%(vec_len)s</value>
    </param>
    <param>
      <name>sample_rate</name>
      <value>1</value>
    </param>
    <param>
      <name>name</name>
      <value>Range FFT (per chirp)</value>
    </param>
  </block>

  <!-- File sink for beat magnitude (optional) -->
  <block>
    <key>blocks.file_sink</key>
    <id>file_sink_beats</id>
    <param>
      <name>filename</name>
      <value>beat_mag.bin</value>
    </param>
    <param>
      <name>type</name>
      <value>float</value>
    </param>
  </block>

  <!-- Connections -->
  <connections>
    <!-- Chirp source -> TX -->
    <connect>
      <src>chirp_source</src>
      <src_port>0</src_port>
      <dst>osmocom_sink_tx</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- Chirp source -> conjugate_ref -->
    <connect>
      <src>chirp_source</src>
      <src_port>0</src_port>
      <dst>conjugate_ref</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- conjugate_ref -> multiply (port 1) -->
    <connect>
      <src>conjugate_ref</src>
      <src_port>0</src_port>
      <dst>multiply_dechirp</dst>
      <dst_port>1</dst_port>
    </connect>

    <!-- RX source -> multiply (port 0) -->
    <connect>
      <src>osmocom_src_rx</src>
      <src_port>0</src_port>
      <dst>multiply_dechirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- multiply -> lowpass -->
    <connect>
      <src>multiply_dechirp</src>
      <src_port>0</src_port>
      <dst>lowpass_after_dechirp</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- lowpass -> waterfall (visual) -->
    <connect>
      <src>lowpass_after_dechirp</src>
      <src_port>0</src_port>
      <dst>qtgui_waterfall</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- lowpass -> stream_to_vector (per-chirp framing) -->
    <connect>
      <src>lowpass_after_dechirp</src>
      <src_port>0</src_port>
      <dst>stream_to_vector</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- stream_to_vector -> FFT -->
    <connect>
      <src>stream_to_vector</src>
      <src_port>0</src_port>
      <dst>fft_block</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- FFT -> complex_to_mag_squared -->
    <connect>
      <src>fft_block</src>
      <src_port>0</src_port>
      <dst>c2m2</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- mag^2 vector -> vector_to_stream -->
    <connect>
      <src>c2m2</src>
      <src_port>0</src_port>
      <dst>vector_to_stream</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- vector_to_stream -> range plot (time sink) -->
    <connect>
      <src>vector_to_stream</src>
      <src_port>0</src_port>
      <dst>qtgui_range_plot</dst>
      <dst_port>0</dst_port>
    </connect>

    <!-- Also save to file -->
    <connect>
      <src>vector_to_stream</src>
      <src_port>0</src_port>
      <dst>file_sink_beats</dst>
      <dst_port>0</dst_port>
    </connect>
  </connections>

  <!-- Parameters computed at runtime -->
  <param_compute>
    <param>
      <name>vec_len</name>
      <expr>int(round(chirp_time * samp_rate))</expr>
    </param>
  </param_compute>

</flow_graph>