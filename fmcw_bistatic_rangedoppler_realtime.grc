      <name>vlen</name>
      <value>%(vec_len)s</value>
    </param>
  </block>

  <!-- Range-Doppler Python block: buffers n_chirps of vec_len floats, computes Doppler FFT, outputs flattened image (float vector of size vec_len*n_chirps) -->
  <python_block>
    <id>range_doppler_block</id>
    <name>range_doppler_block</name>
    <category>Custom</category>
    <import>import numpy as np
from gnuradio import gr</import>
    <make>def __init__(self, vec_len, n_chirps):
    gr.sync_block.__init__(self,
        name='range_doppler_block',
        in_sig=[(np.float32, int(vec_len))],
        out_sig=[(np.float32, int(vec_len*int(n_chirps)))])
    self.vec_len = int(vec_len)
    self.n_chirps = int(n_chirps)
    self.buffer = np.zeros((self.n_chirps, self.vec_len), dtype=np.float32)
    self.ptr = 0
</make>
    <work>def work(self, input_items, output_items):
    # input_items[0] is an array of shape (n_items, vec_len)
    in0 = input_items[0]
    n_items = in0.shape[0]
    out = output_items[0]
    out_count = 0
    for i in range(n_items):
        self.buffer[self.ptr, :] = in0[i].astype(np.float32)
        self.ptr += 1
        if self.ptr >= self.n_chirps:
            # compute Doppler FFT across chirps for each range bin
            # buffer shape: (n_chirps, vec_len)
            # take FFT along axis 0 (chirp axis)
            doppler = np.fft.fftshift(np.fft.fft(self.buffer, axis=0, n=self.n_chirps), axes=0)
            # magnitude
            mag = np.abs(doppler)
            # convert to log scale for display
            mag_db = 20.0 * np.log10(mag + 1e-12)
            # normalize to 0..1
            mag_db -= mag_db.max()
            mag_norm = (mag_db - mag_db.min()) / (mag_db.max() - mag_db.min() + 1e-12)
            # flatten in row-major order with shape (n_chirps, vec_len)
            frame = mag_norm.astype(np.float32).ravel()
            # output one frame
            out[out_count, :len(frame)] = frame
            out_count += 1
            # reset pointer
            self.ptr = 0
    return out_count
</work>
    <params>
      <param>
        <name>vec_len</name>
        <type>int</type>
        <value>%(vec_len)s</value>
      </param>
      <param>
        <name>n_chirps</name>
        <type>int</type>
        <value>%(n_chirps)s</value>
      </param>
    </params>
  </python_block>

  <!-- Vector to stream for image sink: the Python block already outputs a vector per frame; use stream_to_vector not needed -->
