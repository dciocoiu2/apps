<?xml version="1.0" encoding="utf-8"?>
<flow_graph>
  <title>FMCW_Bistatic_RangeDoppler_Realtime</title>
  <author>Generated</author>
  <description>Realtime FMCW bistatic range-Doppler image. HackRF A TX, HackRF B RX. Assumes HackRF A 10MHz OUT -> HackRF B 10MHz IN. Use attenuators and filters for bench tests.</description>
  <id>fmcw_bistatic_rangedoppler_realtime</id>

  <!-- Variables -->
  <variable>
    <name>center_freq</name>
    <value>2440000000</value>
    <type>float</type>
    <desc>Center frequency (Hz)</desc>
  </variable>

  <variable>
    <name>samp_rate</name>
    <value>4000000</value>
    <type>float</type>
    <desc>Sample rate (S/s)</desc>
  </variable>

  <variable>
    <name>chirp_bw</name>
    <value>4000000</value>
    <type>float</type>
    <desc>Chirp sweep bandwidth (Hz)</desc>
  </variable>

  <variable>
    <name>chirp_time</name>
    <value>0.002</value>
    <type>float</type>
    <desc>Chirp duration (s)</desc>
  </variable>

  <variable>
    <name>prf</name>
    <value>200</value>
    <type>float</type>
    <desc>Chirps per second</desc>
  </variable>

  <variable>
    <name>n_chirps</name>
    <value>64</value>
    <type>int</type>
    <desc>Number of chirps per Doppler integration</desc>
  </variable>

  <variable>
    <name>tx_gain</name>
    <value>0</value>
    <type>int</type>
    <desc>TX gain (dB) - keep low for bench tests</desc>
  </variable>

  <variable>
    <name>rx_gain</name>
    <value>20</value>
    <type>int</type>
    <desc>RX gain (dB)</desc>
  </variable>

  <variable>
    <name>device_tx</name>
    <value>hackrf=0</value>
    <type>string</type>
    <desc>TX HackRF device args</desc>
  </variable>

  <variable>
    <name>device_rx</name>
    <value>hackrf=1</value>
    <type>string</type>
    <desc>RX HackRF device args</desc>
  </variable>

  <!-- Computed parameters -->
  <param_compute>
    <param>
      <name>vec_len</name>
      <expr>int(round(chirp_time * samp_rate))</expr>
    </param>
    <param>
      <name>k_slope</name>
      <expr>chirp_bw / chirp_time</expr>
    </param>
  </param_compute>

  <!-- Blocks -->

  <!-- Python chirp generator block -->
  <python_block>
    <id>chirp_source</id>
    <name>chirp_source</name>
    <category>Custom</category>
    <import>import numpy as np
from gnuradio import gr</import>
    <make>def __init__(self, samp_rate, chirp_bw, chirp_time, prf):
    gr.sync_block.__init__(self,
        name='chirp_source',
        in_sig=None,
        out_sig=[np.complex64])
    self.samp_rate = float(samp_rate)
    self.chirp_bw = float(chirp_bw)
    self.chirp_time = float(chirp_time)
    self.prf = float(prf)
    self.chirp_len = int(round(self.chirp_time * self.samp_rate))
    if self.chirp_len < 16:
        self.chirp_len = 16
    t = np.arange(self.chirp_len) / self.samp_rate
    k = self.chirp_bw / self.chirp_time
    phase = 2.0 * np.pi * (0.5 * k * t**2)
    self.chirp = (np.exp(1j * phase)).astype(np.complex64)
    idle_len = int(round((1.0/self.prf - self.chirp_time) * self.samp_rate)) if self.prf>0 else 0
    if idle_len < 0:
        idle_len = 0
    self.packet = np.concatenate((self.chirp, np.zeros(idle_len, dtype=np.complex64)))
    self.ptr = 0
</make>
    <work>def work(self, input_items, output_items):
    out = output_items[0]
    n = len(out)
    for i in range(n):
        out[i] = self.packet[self.ptr]
        self.ptr += 1
        if self.ptr >= len(self.packet):
            self.ptr = 0
    return n
</work>
    <params>
      <param>
        <name>samp_rate</name>
        <type>float</type>
        <value>%(samp_rate)s</value>
      </param>
      <param>
        <name>chirp_bw</name>
        <type>float</type>
        <value>%(chirp_bw)s</value>
      </param>
      <param>
        <name>chirp_time</name>
        <type>float</type>
        <value>%(chirp_time)s</value>
      </param>
      <param>
        <name>prf</name>
        <type>float</type>
        <value>%(prf)s</value>
      </param>
    </params>
  </python_block>

